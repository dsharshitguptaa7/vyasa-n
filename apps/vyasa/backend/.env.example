# ==============================================================================
# VYASA Core Backend - Environment Configuration Template
# NOTE: Copy this file to .env and fill in real values. NEVER commit secrets.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
SERVICE_NAME=vyasa-core-backend
API_PREFIX=/api

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security Foundation (for Auth & JWT Token handling)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
