# ==============================================================================
# VYASA Core Backend - Environment Configuration Template
# NOTE: Copy this file to .env and fill in real values. NEVER commit secrets.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
SERVICE_NAME=vyasa-core-backend
API_PREFIX=/api

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security Foundation (for Auth & JWT Token handling)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# TOTP Two-Factor Authentication Settings
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=VYASA-N
TWO_FACTOR_CHALLENGE_EXPIRE_MINUTES=5
MAX_FAILED_LOGIN_ATTEMPTS=5
FAILED_LOGIN_LOCKOUT_MINUTES=15

# ==============================================================================
# VYASA Centralized Institutional Email & SMTP Configuration
# Set EMAIL_ENABLED=true and provide SMTP credentials for live delivery.
# In development/test, leave EMAIL_ENABLED=false to safely simulate dispatch.
# ==============================================================================
EMAIL_ENABLED=True
# Email Provider: brevo, smtp, or simulation
EMAIL_PROVIDER=brevo
# Brevo API Key (Transactional Email API v3) - NEVER commit real keys
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
SMTP_HOST=smtp.csjmu.ac.in
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM_ADDRESS=noreply@csjmu.ac.in
EMAIL_FROM_NAME="VYASAᴺ — CSJMU Kanpur"
PORTAL_BASE_URL=https://vyasa.csjmu.ac.in
SUPPORT_CONTACT_EMAIL=grievance.support@csjmu.ac.in

# ==============================================================================
# Isolated Test Database Configuration (REQUIRED FOR BACKEND TESTS)
# Must point to a completely isolated PostgreSQL database (local or cloud).
# Tests will FAIL CLOSED if this is not provided, or if it matches DATABASE_URL.
# SQLite is strictly rejected. Passwords/credentials are masked in logs.
# ==============================================================================
# TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/vyasa_test_db

# ==============================================================================
# Secure Storage Foundation
# Base filesystem path for uploaded bulletins, documents, and media assets.
# Certificate PDFs and private assets are stored with restricted permissions.
# ==============================================================================
STORAGE_BASE_DIR=storage

